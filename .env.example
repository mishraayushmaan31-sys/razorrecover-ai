# Application
NODE_ENV=development
APP_ENV=demo
APP_NAME=razorrecover-ai
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=RazorRecover AI

# Auth / security
JWT_SECRET=replace_with_secure_secret
SESSION_SECRET=replace_with_a_32_character_server_secret
AUTH_TRUST_HOST=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/razorrecover

# AI providers
OPENAI_API_KEY=replace_with_openai_key
ANTHROPIC_API_KEY=replace_with_anthropic_key
AI_PROVIDER=openai

# Razorpay test mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret
RAZORPAY_MODE=test
RAZORPAY_TIMEOUT_MS=8000
RAZORPAY_MAX_RETRIES=2

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# Feature flags
ENABLE_DEMO_MODE=true
ENABLE_TEST_MODE=true
ENABLE_PRODUCTION_MODE=false

# App internal policies
DEFAULT_POLICY_MODE=demo
RISK_GATE_MODE=deterministic
