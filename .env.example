# Application Configuration
NODE_ENV=development
APP_ENV=demo
APP_NAME=razorrecover-ai
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=RazorRecover AI

# Authentication & Security
# Generate a secure random string (32+ characters)
JWT_SECRET=your_jwt_secret_here
# Generate a secure random string (32+ characters minimum)
SESSION_SECRET=your_session_secret_here
AUTH_TRUST_HOST=true

# Database Connection
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/razorrecover

# AI Provider Configuration
# Supported providers: openai, anthropic
OPENAI_API_KEY=sk_test_...
ANTHROPIC_API_KEY=sk_ant_...
AI_PROVIDER=openai

# Razorpay Integration (Test/Development)
# Get test credentials from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_MODE=test
RAZORPAY_TIMEOUT_MS=8000
RAZORPAY_MAX_RETRIES=2

# Observability & Monitoring
LOG_LEVEL=info
# Optional: Sentry DSN for error tracking
SENTRY_DSN=

# Feature Flags
ENABLE_DEMO_MODE=true
ENABLE_TEST_MODE=true
ENABLE_PRODUCTION_MODE=false

# Internal Policies
DEFAULT_POLICY_MODE=demo
RISK_GATE_MODE=deterministic
